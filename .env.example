# deploy.sh generates random values for these when .env does not exist.
SECRET_KEY=replace-with-at-least-32-random-characters
ADMIN_PASSWORD=replace-with-a-strong-password
POSTGRES_PASSWORD=replace-with-a-random-database-password
APP_PORT=8000
COOKIE_SECURE=false
# Optional: otherwise enter your key for each generation in /admin.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
MATH_QUESTION_COUNT=24
LOGIC_QUESTION_COUNT=20
CORRECT_ANSWER_COOLDOWN_DAYS=7
# Local development defaults to SQLite. Docker overrides this with PostgreSQL.
# DATABASE_URL=sqlite:///./cst.db
